APP_NAME="ResearchMind AI"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:3000

# Scholarly Sources (Phase 2)
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=0.5

# Optional Backend API Keys (backend-only, leave empty if not used)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Hybrid Retrieval (Phase 4)
RETRIEVAL_CANDIDATE_LIMIT=20
BM25_K1=1.5
BM25_B=0.75
SBERT_MODEL_NAME=all-MiniLM-L6-v2
RRF_K=60
RRF_BM25_WEIGHT=1.0
RRF_SBERT_WEIGHT=1.0

# Cross-Encoder Reranking (Phase 5)
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_MODEL_VERSION=1.0.0
CROSS_ENCODER_BATCH_SIZE=16
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_TOP_K=20
CROSS_ENCODER_ENABLED=true

# Database & Persistence (Phase 9)
# Use SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./researchmind.db
# Or PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchmind
DATABASE_ECHO=false
VECTOR_INDEX_DIR=./data/vectors
RATE_LIMIT_REQUESTS_PER_MINUTE=120
ENABLE_OBSERVABILITY_METRICS=true
